        "amount": 500,
        "currency": "USD",
        "description": "Steps to reproduce: run the failing command. Expected behavior: pass. Actual behavior: fail."
      }
    ]
  },
  "opire": {
    "listings": [
      {
        "url": "https://opire.dev/example",
        "issueUrl": "https://github.com/owner/repo/issues/456",
        "title": "Example Opire bounty",
        "amount": 300,
        "currency": "USD",
        "description": "Steps to reproduce: open the page. Expected behavior: pass. Actual behavior: fail."
      }
    ]
  }
