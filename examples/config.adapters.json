{
  "githubTokenEnv": "GITHUB_TOKEN",
  "statePath": "./reports/radar-state.json",
  "defaults": {
    "maxIssuesPerQuery": 5,
    "includeClosed": false,
    "linkedPullRequestDetection": "both"
  },
  "filters": {
    "minAmount": 100,
    "excludeKeywords": []
  },
  "repositories": [
    {
      "owner": "Expensify",
      "repo": "App",
      "presets": ["external"]
    }
  ],
  "algora": {
    "listings": [
      {
        "url": "https://console.algora.io/example",
        "githubIssueUrl": "https://github.com/owner/repo/issues/123",
