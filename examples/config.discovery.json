{
  "githubTokenEnv": "GITHUB_TOKEN",
  "statePath": "./reports/discovery-state.json",
  "workspacePath": "./reports/discovery-workspace.json",
  "notifications": {
    "notifyOnFirstRun": false,
    "rules": {
      "preset": "quiet",
      "minSeverity": "medium",
      "actions": ["act-now", "watch", "manual-review"],
      "minAmount": 100,
      "competitionRisks": ["none", "low", "medium"]
    },
    "telegram": {
      "enabled": false,
      "botTokenEnv": "TELEGRAM_BOT_TOKEN",
      "chatIdEnv": "TELEGRAM_CHAT_ID"
    },
    "webhook": {
      "enabled": false,
      "urlEnv": "OPEN_BOUNTY_RADAR_WEBHOOK_URL"
    }
  },
  "defaults": {
    "maxIssuesPerQuery": 5,
    "globalMaxIssuesPerQuery": 3,
    "includeClosed": false,
    "linkedPullRequestDetection": "both",
    "competitionDetails": true,
    "competitionDetailLimit": 8,
    "commentSignalLimit": 50
  },
  "filters": {
    "minAmount": 100,
    "excludeKeywords": [
      "claim",
      "claimed",
      "hardware",
      "marketing",
      "MRWK",
      "RTC",
      "star",
      "token"
    ]
  },
  "repositories": [
    {
      "owner": "Expensify",
      "repo": "App",
      "presets": [],
      "queries": [
        "$ in:title,body label:External",
        "$250 in:title,body label:External",
        "$500 in:title,body label:External",
        "/bounty in:body label:External",
        "reward in:title,body label:External",
        "bounty in:title,body label:External"
      ]
    }
  ],
  "githubSearches": [
    {
      "name": "global-bounty-title-amounts",
      "linkedPullRequestDetection": "search",
      "competitionDetails": false,
      "queries": [
        "bounty in:title \"$100\" archived:false",
        "bounty in:title \"$250\" archived:false",
        "bounty in:title \"$300\" archived:false",
        "bounty in:title \"$500\" archived:false"
      ]
    },
    {
      "name": "global-bounty-labels",
      "linkedPullRequestDetection": "search",
      "competitionDetails": false,
      "queries": [
        "label:bounty bounty in:title,body archived:false",
        "\"bounty\" \"USDC\" in:title,body archived:false"
      ]
    }
  ]
}
